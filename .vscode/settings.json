{
    // Build (Ctrl+Alt+B) via tools/vscode-tectonic.bat so tectonic finds biber
    // without the pixi environment active. Run `pixi install` once after cloning.
    "latex-workshop.latex.tools": [
        {
            "name": "tectonic",
            "command": "cmd",
            "args": [
                "/c",
                "%WORKSPACE_FOLDER%/tools/vscode-tectonic.bat",
                "--synctex",
                "--keep-intermediates",
                "-Z", "shell-escape-cwd=%OUTDIR%",
                "--outdir=%OUTDIR%",
                "%DOC_EXT%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "tectonic",
            "tools": ["tectonic"]
        }
    ],
    // Outputs go to build/ at the repo root. Anchored to %WORKSPACE_FOLDER%:
    // %DIR%-relative paths threw meetings.tex's output above the repo.
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
    // The PDF tab becoming active after a build would otherwise expand build/ in the Explorer.
    "explorer.autoRevealExclude": {
        "**/build": true
    }
}
