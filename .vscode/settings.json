{
    // Build (Ctrl+Alt+B) via tools/tectonic-biber.bat so tectonic finds biber
    // without the pixi environment active. Run `pixi install` once after cloning.
    "latex-workshop.latex.tools": [
        {
            "name": "tectonic",
            "command": "cmd",
            "args": [
                "/c",
                "%WORKSPACE_FOLDER%/tools/tectonic-biber.bat",
                "--synctex",
                "--outdir=%OUTDIR%",
                "%DOC_EXT%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "tectonic",
            "tools": ["tectonic"]
        }
    ],
    // Outputs go to build/ at the repo root. Anchored to %WORKSPACE_FOLDER%:
    // %DIR%-relative paths threw meetings.tex's output above the repo.
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build"
}
