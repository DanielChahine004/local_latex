# pixi environments
.pixi/*
!.pixi/config.toml

# build output (keep the dir so tectonic's --outdir exists on a fresh clone)
build/*
!build/.gitkeep

# generated by tools/count_sentences.py and tools/check_units.py
src/thesis/sentence-counts.tex
src/thesis/unit-warnings.tex
# check_units.py imports count_sentences.py
tools/__pycache__/

# LaTeX intermediates
*.aux
*.log
*.bbl
*.blg
*.synctex.gz

# copied from src/thesis by build-notes (canonical copies live there)
src/paper-notes/units.tex
src/paper-notes/theme.tex
src/paper-notes/references.bib
