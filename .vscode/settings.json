{
    // Build with Tectonic from the pixi environment (Ctrl+Alt+B).
    // Goes through tools/tectonic-biber.bat so tectonic can find biber
    // (needed for biblatex) without the pixi environment being active.
    // Run `pixi install` once after cloning so .pixi/ exists.
    "latex-workshop.latex.tools": [
        {
            "name": "tectonic",
            "command": "cmd",
            "args": [
                "/c",
                "%WORKSPACE_FOLDER%/tools/tectonic-biber.bat",
                "--synctex",
                "--outdir=%OUTDIR%",
                "%DOC_EXT%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "tectonic",
            "tools": ["tectonic"]
        }
    ],
    // Put the PDF and other outputs in build/ at the repo root. Anchored to
    // %WORKSPACE_FOLDER%, not %DIR%/../build -- the latter is relative to the
    // root .tex file, so it only landed correctly for src/thesis.tex and threw
    // meetings.tex's output one level above the repo.
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build"
}
