# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Line endings. Blobs stay LF, working trees get CRLF whatever a machine's
# core.autocrlf happens to be -- so the local/Overleaf round-trip cannot rewrite
# a whole file and bury the one sentence that actually changed.
*.tex text eol=crlf
*.bib text eol=crlf
*.md  text eol=crlf

# Exception: the paper notes are edited live in JupyterLab, which always writes
# LF. They never go to Overleaf, so the CRLF rule buys nothing here and would
# mark the whole file changed after every save.
src/paper-notes/**.tex text eol=lf

# shell scripts run on Linux: keep LF whatever the checkout machine
*.sh text eol=lf
tools/tikz-external text eol=lf
